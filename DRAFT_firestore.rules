rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'voiceMode', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'personaInstructions',
          'customGlbUrl',
          'voiceMode',
          'language',
          'liveVoiceName',
          'speechRate',
          'speechPitch',
          'handsFreeLoop',
          'standbyWakeEnabled',
          'secretWakePhrase',
          'secretShutdownPhrase',
          'voiceCodesConfigured',
          'lastActiveAt',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('personaInstructions' in data) || (data.personaInstructions is string && data.personaInstructions.size() <= 4000))
        && (!('customGlbUrl' in data) || (data.customGlbUrl is string && data.customGlbUrl.size() <= 1000))
        && data.voiceMode in ['browser', 'live']
        && data.language in ['en-US', 'bn-BD']
        && (!('liveVoiceName' in data) || data.liveVoiceName in ['Zephyr', 'Puck', 'Kore', 'Fenrir', 'Charon'])
        && (!('speechRate' in data) || (data.speechRate is number && data.speechRate >= 0.5 && data.speechRate <= 2.0))
        && (!('speechPitch' in data) || (data.speechPitch is number && data.speechPitch >= 0.5 && data.speechPitch <= 2.0))
        && (!('handsFreeLoop' in data) || data.handsFreeLoop is bool)
        && (!('standbyWakeEnabled' in data) || data.standbyWakeEnabled is bool)
        && (!('secretWakePhrase' in data) || (data.secretWakePhrase is string && data.secretWakePhrase.size() <= 500))
        && (!('secretShutdownPhrase' in data) || (data.secretShutdownPhrase is string && data.secretShutdownPhrase.size() <= 500))
        && (!('voiceCodesConfigured' in data) || data.voiceCodesConfigured is bool)
        && (!('lastActiveAt' in data) || (data.lastActiveAt is string && data.lastActiveAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['userId', 'secretWakePhrase', 'secretShutdownPhrase', 'voiceCodesConfigured', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId',
          'secretWakePhrase',
          'secretShutdownPhrase',
          'voiceCodesConfigured',
          'personaInstructions',
          'customGlbUrl',
          'voiceMode',
          'language',
          'liveVoiceName',
          'speechRate',
          'speechPitch',
          'handsFreeLoop',
          'standbyWakeEnabled',
          'lastActiveAt',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.secretWakePhrase is string
        && data.secretWakePhrase.size() <= 500
        && data.secretShutdownPhrase is string
        && data.secretShutdownPhrase.size() <= 500
        && data.voiceCodesConfigured is bool
        && (!('personaInstructions' in data) || (data.personaInstructions is string && data.personaInstructions.size() <= 4000))
        && (!('customGlbUrl' in data) || (data.customGlbUrl is string && data.customGlbUrl.size() <= 1000))
        && (!('voiceMode' in data) || data.voiceMode in ['browser', 'live'])
        && (!('language' in data) || data.language in ['en-US', 'bn-BD'])
        && (!('liveVoiceName' in data) || data.liveVoiceName in ['Zephyr', 'Puck', 'Kore', 'Fenrir', 'Charon'])
        && (!('speechRate' in data) || (data.speechRate is number && data.speechRate >= 0.5 && data.speechRate <= 2.0))
        && (!('speechPitch' in data) || (data.speechPitch is number && data.speechPitch >= 0.5 && data.speechPitch <= 2.0))
        && (!('handsFreeLoop' in data) || data.handsFreeLoop is bool)
        && (!('standbyWakeEnabled' in data) || data.standbyWakeEnabled is bool)
        && (!('lastActiveAt' in data) || (data.lastActiveAt is string && data.lastActiveAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemoryNote(data, userId) {
      return data.keys().hasAll(['userId', 'category', 'content', 'createdAt'])
        && data.keys().hasOnly(['userId', 'category', 'content', 'createdAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.category in ['profile', 'note', 'reminder']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidChatTurn(data, userId) {
      return data.keys().hasAll(['userId', 'role', 'text', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['userId', 'role', 'text', 'timestamp', 'createdAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.role in ['user', 'model']
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 4000
        && data.timestamp is string
        && data.timestamp.size() >= 1
        && data.timestamp.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidStudyTask(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'subject', 'dueLabel', 'completed', 'createdAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 120))
        && (!('dueLabel' in data) || (data.dueLabel is string && data.dueLabel.size() <= 120))
        && data.completed is bool
        && data.createdAt is timestamp;
    }

    function isValidStudySession(data, userId) {
      return data.keys().hasAll(['userId', 'label', 'durationMinutes', 'completedAt'])
        && data.keys().hasOnly(['userId', 'label', 'durationMinutes', 'completedAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 200
        && data.durationMinutes is number
        && data.durationMinutes >= 1
        && data.durationMinutes <= 600
        && data.completedAt is timestamp;
    }

    function isValidSmartNote(data, userId) {
      return data.keys().hasAll(['userId', 'kind', 'content', 'reminded', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'kind', 'content', 'remindAt', 'dueLabel', 'reminded', 'completed', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.kind in ['note', 'reminder']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 1000
        && (!('remindAt' in data) || (data.remindAt is string && data.remindAt.size() <= 64))
        && (!('dueLabel' in data) || (data.dueLabel is string && data.dueLabel.size() <= 120))
        && data.reminded is bool
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'personaInstructions',
          'customGlbUrl',
          'voiceMode',
          'language',
          'liveVoiceName',
          'speechRate',
          'speechPitch',
          'handsFreeLoop',
          'standbyWakeEnabled',
          'secretWakePhrase',
          'secretShutdownPhrase',
          'voiceCodesConfigured',
          'lastActiveAt',
          'updatedAt'
        ]);

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /settings/{settingId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidUserSettings(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidUserSettings(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'secretWakePhrase',
              'secretShutdownPhrase',
              'voiceCodesConfigured',
              'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'personaInstructions',
              'customGlbUrl',
              'voiceMode',
              'language',
              'liveVoiceName',
              'speechRate',
              'speechPitch',
              'handsFreeLoop',
              'standbyWakeEnabled',
              'secretWakePhrase',
              'secretShutdownPhrase',
              'voiceCodesConfigured',
              'lastActiveAt',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(settingId);
      }

      match /memories/{memoryId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow list: if isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(memoryId)
          && isValidMemoryNote(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(memoryId)
          && isValidMemoryNote(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'content']);

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(memoryId);
      }

      match /notes/{noteId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && isValidSmartNote(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && isValidSmartNote(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['kind', 'content', 'remindAt', 'dueLabel', 'reminded', 'completed', 'updatedAt']);

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(noteId);
      }

      match /history/{turnId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(turnId);
        allow list: if isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(turnId)
          && isValidChatTurn(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(turnId);
      }

      match /tasks/{taskId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(taskId);
        allow list: if isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && isValidStudyTask(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && isValidStudyTask(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'dueLabel', 'completed']);

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(taskId);
      }

      match /sessions/{sessionId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidStudySession(incoming(), userId)
          && incoming().completedAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
